---
layout: null
---
[
  {% assign cutoff = site.archive_cutoff_date | date: '%Y-%m-%d' %}
  {% for post in site.posts %}
  {% if post.date | date: '%Y-%m-%d' >= cutoff %}
    {
      "title"    : "{{ post.title | escape }}",
      "subtitle" : "{{ post.subtitle | escape }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    }{% unless forloop.last %},{% endunless %}
  {% endif %}
  {% endfor %}
]
