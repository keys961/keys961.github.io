---
layout: null
---
[
  {% assign active_posts = site.posts | where_exp: "post", "post.date | date: '%Y-%m-%d' >= site.archive_cutoff_date" %}
  {% for post in active_posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "subtitle" : "{{ post.subtitle | escape }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
